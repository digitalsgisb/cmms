CMMS_PORT=3300
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=replace-with-a-different-long-unique-password
DEVELOPER_NAME=CMMS Developer
USER_PASSWORDS_JSON={"hafiz":"replace-with-unique-password","kumar":"replace-with-another-password","azlan":"replace-with-third-password"}
APP_PUBLIC_URL=https://cmms.sugidigital.org

# Generate once with `pnpm push:keys`. Keep the private key secret and stable.
VAPID_SUBJECT=mailto:cmms@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# These may be configured later from Developer Mode > Settings instead.
WORK_ORDER_SYNC_SCRIPT_URL=
WORK_ORDER_SYNC_TOKEN=
WORK_ORDER_SYNC_SHEET_NAME=WorkOrders
WORK_ORDER_WEBHOOK_URL=

# AppSheet Air Leak integration. These can also be configured in Settings.
APPSHEET_AIR_LEAK_INBOUND_TOKEN=
APPSHEET_AIR_LEAK_SCRIPT_URL=
APPSHEET_AIR_LEAK_SCRIPT_TOKEN=
APPSHEET_AIR_LEAK_SHEET_NAME=Main

# Weekly management report: local Ollama and restricted n8n integration.
# Leave the model blank to use factual summaries until Ollama is installed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Generate a random token of at least 32 characters; store it in n8n Header Auth.
CMMS_REPORT_TOKEN=
# Production URL from the manual n8n workflow; token matches its Header Auth credential.
CMMS_REPORT_WEBHOOK_URL=
CMMS_REPORT_WEBHOOK_TOKEN=
# Use port-klang,sendayan to permit combined reports.
CMMS_REPORT_PLANTS=port-klang
# Required only by compose.reporting.yaml. Keep stable and back it up securely.
N8N_ENCRYPTION_KEY=
